# Environment (development | test | integration)
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_dev"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_test"
INTEGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_integration"

# JWT Auth
JWT_SECRET="replace-with-a-strong-random-secret-key"
JWT_EXPIRES_IN="15m"

# File Storage
STORAGE_PROVIDER="local"
STORAGE_BUCKET="app-uploads"
STORAGE_ACCESS_KEY="replace-with-storage-access-key"
STORAGE_SECRET_KEY="replace-with-storage-secret-key"

# AI Service
AI_API_KEY="replace-with-ai-api-key"
AI_MODEL="gpt-4o-mini"
